# Edge Add-ons Publisher API 配置 (v1.1)
# 获取方式：
#   1. 登录 https://partner.microsoft.com
#   2. Microsoft Edge → 发布 API
#   3. 点击"启用"切换到 v1.1
#   4. 点击"创建 API 凭据"
#   5. 复制 Client ID 和 API Key
#   6. Product ID 在扩展概览页面获取

CLIENT_ID=
CLIENT_SECRET=
PRODUCT_ID=

# Chrome Web Store API v2 配置（npm run release 需要）
# 获取步骤见 README「维护者发布」：服务账号密钥 + 开发者后台授权 + Publisher ID
# 扩展 ID：开发者后台扩展名称下方，或商店详情页 URL 末尾
CHROME_EXTENSION_ID=
# Publisher ID：开发者后台 Publisher → Settings（URL 中的 UUID）
CHROME_PUBLISHER_ID=
# 服务账号密钥 JSON 的相对路径（推荐；文件含私钥，勿提交）
CHROME_SERVICE_ACCOUNT_JSON=
# 备选认证：OAuth 桌面客户端（npm run chrome:login 自动写入以下三项，配置后优先使用）
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
# 或不使用 JSON 文件，直接填服务账号 JSON 中的 client_email / private_key
# （private_key 可保持一行，字面量 \n 会在发布前自动还原）
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# Firefox Add-ons (AMO) 配置
# 获取方式：
#   1. 登录 https://addons.mozilla.org/developers/ 并接受分发协议
#   2. 右上角头像 → Tools → Manage API Keys → Generate new credentials
#   3. JWT issuer（形如 user:12345678:987）和 JWT secret（只显示一次）
# 首次上架必须在开发者中心网页手工上传，API 只能提交后续版本。
# 源码包默认会上传到 AMO 公开下载，wxt.config.ts 已排除 keys/。
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
# listed（公开上架）或 unlisted（仅自托管签名）
FIREFOX_CHANNEL=listed
