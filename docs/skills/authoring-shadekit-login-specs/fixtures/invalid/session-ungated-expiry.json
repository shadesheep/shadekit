{
  "version": 2,
  "ops": [
    { "op": "http.execute", "url": "{origin}/api/login", "method": "POST", "as": "login" },
    {
      "op": "map",
      "input": "$login.code",
      "cases": [{ "equals": 0, "value": "$login.data" }],
      "as": "accepted"
    },
    { "op": "auth.write" }
  ],
  "success": [{ "response": { "from": "login", "path": "code", "equals": 0 } }],
  "auth": {
    "mode": "engine",
    "cookiesWrite": [{
      "name": "session",
      "value": "$accepted.token",
      "expiresFrom": { "from": "login", "path": "data.expires", "unit": "epochS" }
    }]
  }
}
