{
  "format": "dt-login-config/v1",
  "specVersion": 2,
  "requiredVars": [{ "name": "privateKey" }],
  "environments": [{
    "name": "Secret",
    "url": "{origin}",
    "requiredVars": [{ "name": "privateKey" }],
    "spec": {
      "version": 2,
      "vars": [{ "name": "privateKey", "secret": true }],
      "ops": [{ "op": "payload.build", "join": "", "parts": [{ "value": "{privateKey}" }], "as": "result" }],
      "success": [{ "token": { "from": "result", "path": "token" } }],
      "auth": { "mode": "engine" }
    }
  }]
}
